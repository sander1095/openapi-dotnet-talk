{
  "$schema": "https://aka.ms/codetour-schema",
  "title": "Demo 1",
  "steps": [
    {
      "file": "demo1-using-openapi/ApiModels/TalkModel.cs",
      "line": 6,
      "selection": {
        "start": {
          "line": 6,
