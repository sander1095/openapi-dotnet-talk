{
  "openapi": "3.2.0",
  "info": {
    "title": "WhatsNewInDotnet11 | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5306"
    }
  ],
  "paths": {
    "/api/talks/search": {
      "query": {
        "tags": [
          "Talks"
        ],
        "operationId": "Talks_Search",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TalkSearch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TalkModel"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/talks/live": {
      "get": {
        "tags": [
          "Talks"
        ],
        "operationId": "Talks_Live",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "required": [
                    "data"
                  ],
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/TalkModel"
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/talks/{id}/session": {
      "get": {
        "tags": [
          "Talks"
        ],
        "operationId": "Talks_GetSession",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          }
        }
      }
    },
    "/api/talks/{id}/export": {
      "get": {
        "tags": [
          "Talks"
        ],
        "operationId": "Talks_Export",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TalkModel"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/speakers/search": {
      "query": {
        "tags": [
          "Speakers"
        ],
        "operationId": "Speakers_Search",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpeakerSearch"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SpeakerSearch"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SpeakerSearch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SpeakerModel"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SpeakerModel"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SpeakerModel"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Session": {
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/TalkModel"
          },
          {
            "$ref": "#/components/schemas/Workshop"
          }
        ]
      },
      "SpeakerModel": {
        "required": [
          "name",
          "country"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "country": {
            "type": "string"
          }
        }
      },
      "SpeakerSearch": {
        "required": [
          "name",
          "country"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "country": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TalkModel": {
        "required": [
          "id",
          "title",
          "lengthInMinutes",
          "roomName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "lengthInMinutes": {
            "maximum": 640,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "roomName": {
            "type": "string",
            "description": "The name of the room where the talk will take place."
          }
        }
      },
      "TalkSearch": {
        "required": [
          "title",
          "maxLengthInMinutes"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "maxLengthInMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "Workshop": {
        "required": [
          "title",
          "lengthInMinutes"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "lengthInMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Speakers"
    },
    {
      "name": "Talks"
    }
  ]
}